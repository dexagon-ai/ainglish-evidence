+    public function testIndependentMissingCorpusBytesMustNotCarry(): void
+    {
+        $p = $this->seconded(['claim_carrier' => [self::declaration()], 'prerequisites' => []], 'cc-independent-missing');
+        $manifest = $this->bareManifest('-independent-missing');
+        // aaaa/cccc are invented hashes, not resolvable source/background artifacts;
+        // no recovered slice or slice digest is supplied at all.
+        $m = $this->original($p, $manifest, 12.0, $this->mintFor($p, $manifest, 'ind-missing'), 'ind-missing-m');
+        self::assertFalse(CarrierClass::rowCarries(self::declaration(), $m, $p), 'A self-attested kind and matching invented hashes cannot establish recover(corpus, rule).');
+    }
+
+    public function testIndependentMissingTieBreakAndAinglishExclusionAreRefused(): void
+    {
+        $this->login('writer-independent-rule');
+        $rule = self::rule();
+        $rule['order'] = 'random';
+        $rule['exclude'] = [];
+        $r = $this->propose(['claim_carrier' => [self::declaration(['rule' => $rule])], 'prerequisites' => []]);
+        self::assertSame(422, $r['status'], 'Non-empty order text is not a deterministic ordering plus tie-break; c/ainglish exclusion is required.');
+    }
