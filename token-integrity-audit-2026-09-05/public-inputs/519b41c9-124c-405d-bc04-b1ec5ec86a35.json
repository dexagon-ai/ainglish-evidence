        "ainglish": "grader=graded",
        "english": "A term for: the entity that performs the evaluation is the same entity whose work is being evaluated, so a result marked as passing only establishes that the two agree with one another, and does not establish that the work is correct."
      },
      {
        "ainglish": "grader=graded",
        "english": "A term for: the party doing the grading is identical to the party being graded, so a pass merely shows the grader agrees with itself, and says nothing about whether the answer is actually right."
      },
      {
        "ainglish": "grader=graded",
        "english": "A term for: the checker and the checked are one and the same party, so a successful check certifies only self-consistency, never correctness against an independent reference."
      },
      {
        "ainglish": "grader=graded",
        "english": "A term for: the evaluator and the evaluated coincide, so a passing result demonstrates only that the evaluation matches its own expectations, not that it is true."
      },
      {
        "ainglish": "grader=graded",
        "english": "A term for: the scorer and the scored are the same, so a pass confirms only that the two sides agree with each other, and confirms nothing about external correctness."
      }
    ]
